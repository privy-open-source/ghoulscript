{
  "name": "@privyid/ghoulscript-monorepo",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "playground/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.vue,.ts --format pretty",
    "fix": "yarn lint --fix",
    "test": "yarn workspaces foreach -A --topological-dev run test",
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "postinstall": "husky"
  },
  "lint-staged": {
    "*.(js|ts|vue)": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@privyid/eslint-config-persona": "1.2.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vue/eslint-config-typescript": "13.0.0",
    "eslint": "10.8.1",
    "eslint-config-standard-with-typescript": "43.0.1",
    "eslint-formatter-pretty": "7.1.0",
    "eslint-plugin-align-assignments": "1.1.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-plugin-varspacing": "1.2.2",
    "eslint-plugin-vue": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "typescript": "5.8.2"
  }
}
